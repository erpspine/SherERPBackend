  "J": {
    "title": "Operational Response Review",
    "fields": [
      {
        "key": "field0",
        "label": "Was SHER notified promptly?",
        "type": "select",
        "options": [
          "Yes",
          "No",
          "Not established",
          "Not applicable"
        ]
